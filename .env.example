# Copy to .env (gitignored). Every value has a working default.

# --- The stack (compose.yaml) ---------------------------------------------

# Station folders: one per frequency, named in stations.js. The folder is
# the station: audio files, plus any extras named after a track.
STATION_59="/path/to/59 Songs You MUST Hear Before You Die"

# Localhost by default. For LAN access, use this computer's LAN IP.
BIND_ADDRESS=127.0.0.1
WEBSEED_PORT=8001
TRACKER_PORT=8002

# Chat rooms the stack's peer sits in and relays, comma-separated.
ROOMS=trade

# Optional: a Cloudflare Tunnel token, for docker compose --profile tunnel.
# In the tunnel's settings, route a hostname to http://webseed:8001; it
# becomes SRC_SEED_URL below. Publishing the tracker too (a hostname to
# http://tracker:8002, as SRC_TRACKER_URL) is optional: the public trackers
# already connect peers, and this only adds one that does not depend on them.
# TUNNEL_TOKEN=

# --- The site (main.js) ---------------------------------------------------

# Where browsers find the stack. The defaults are the stack on this machine.
# A deploy build leaves localhost addresses out; set SRC_TRACKER_URL empty to
# rely on the public trackers alone, here too.
# SRC_SEED_URL=https://seed.src.eco
# SRC_TRACKER_URL=wss://tracker.src.eco

# Cloudflare Pages, for node main.js --deploy. With a domain set, the deploy
# points that domain's CNAME at Pages.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_PAGES_DOMAIN=src.eco
# CLOUDFLARE_PAGES_PROJECT=src-eco
