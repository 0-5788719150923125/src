# Copy to .env (gitignored). Every value has a working default.

# --- The stack (compose.yaml) ---------------------------------------------

# Station folders: one per frequency, named in stations.js. The folder is
# the station: audio files, plus any extras named after a track. The
# frequency names the variable, a dot becoming an underscore (59.1). The build
# hashes it into the station's .torrent, the deploy uploads it to the
# mirror, and the stack seeds it.
STATION_59_1="/path/to/59 Songs You MUST Hear Before You Die"

# Localhost by default. For LAN access, use this computer's LAN IP.
BIND_ADDRESS=127.0.0.1
WEBSEED_PORT=8001
TRACKER_PORT=8002

# Chat rooms the stack's peer sits in and relays, comma-separated.
ROOMS=trade

# Test peers for the ghost text's swarm memory (docker compose --profile
# test up -d --build peers, or node main.js --peers 8). They join PEER_ROOM
# and remember PEER_DATA: tinystories (children's stories) or quijote (Don
# Quijote, in Spanish). Open the site at ?room=<PEER_ROOM> to meet them.
# PEERS=8
# PEER_DATA=tinystories
# PEER_ROOM=memorytest
# To try a flaky room: the share of questions left unanswered, and the
# most ms an answer is held back.
# PEER_DROP=0.5
# PEER_DELAY=400

# A public server, with TLS: Traefik in front of the tracker and the web
# seed, with certificates from Let's Encrypt (npm run public, the public
# profile). Point each hostname's DNS
# at the server and open TCP 80 and 443. ACME_EMAIL is optional. While
# trying it out, use Let's Encrypt's staging server, which has no rate
# limits but issues untrusted certificates:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# TRACKER_HOST=tracker.src.eco
# SEED_HOST=seed.src.eco
# ACME_EMAIL=
# PUBLIC_HTTP_PORT=80
# PUBLIC_HTTPS_PORT=443
#
# The seeder uses the host's network, so browsers reach it at the machine's
# own address (on a public server, with no TURN relay). Open WEBRTC_PORTS
# (UDP) in a public server's firewall and the cloud provider's. Each peer connection,
# and each offer waiting for an answer, holds one port; past the range's
# size, new connections are refused. UPLOAD_LIMIT caps what the seeder
# uploads, in KiB/s (0: no cap); the swarm makes up the rest.
# WEBRTC_PORTS=51000-51999
# UPLOAD_LIMIT=0

# Optional: a Cloudflare Tunnel token, for docker compose --profile tunnel.
# In the tunnel's settings, route a hostname to http://webseed:8001; it
# becomes SRC_SEED_URL below. Publishing the tracker too (a hostname to
# http://tracker:8002, as SRC_TRACKER_URL) is optional: the public trackers
# already connect peers, and this only adds one that does not depend on them.
# TUNNEL_TOKEN=

# --- The site (main.js) ---------------------------------------------------

# Where browsers find the stack, if anywhere: nothing points at it unless
# set (the stack on this machine is http://localhost:8001 and
# ws://localhost:8002). A deploy build leaves localhost addresses out. The
# stack does not have to be public, or running: the build makes each station's .torrent from its folder and
# bundles it into the site, and visitors get the songs from other listeners
# (and the seeder, when it is up) through the public trackers, and from the
# mirror below. A public SRC_SEED_URL adds the web seed as a source.
# SRC_SEED_URL=https://seed.src.eco
# SRC_TRACKER_URL=wss://tracker.src.eco

# Cloudflare Pages, for node main.js --deploy (npm run deploy) and
# --undeploy (npm run undeploy). The token needs Pages: Edit, and for a
# custom domain, DNS: Edit and Cache Purge on its zone. With a domain set,
# the deploy points that domain's CNAME at Pages (taking over one that
# exists), and undeploy deletes it. A project serves
# one site: both refuse a project that serves another custom domain (the
# src-eco project serves src.eco), so test on dev.src.eco with its own.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_PAGES_DOMAIN=dev.src.eco
# CLOUDFLARE_PAGES_PROJECT=src-dev

# The radio's mirror (optional; scripts/mirror.js): every station's files in
# a Cloudflare R2 bucket at a domain of its own, which browsers fall back to
# only when no peer has a song (none turns up within 6 s, a song does not
# start within 10 s, or playback stalls for 5 s). Set both or neither. The
# deploy creates the bucket, its CORS and the domain (a name of one level
# under the zone, so the zone's certificate covers it: radio-dev.src.eco,
# not radio.dev.src.eco), checks each station folder (STATION_59_1 above)
# against its .torrent, and uploads only what the bucket lacks; undeploy
# removes it. R2 has to be enabled once in the dashboard, and the token
# needs Account > Workers R2 Storage > Edit. Free while the stations fit in
# 10 GB, and R2 charges nothing for downloads.
# CLOUDFLARE_R2_BUCKET=src-dev-radio
# CLOUDFLARE_R2_DOMAIN=radio-dev.src.eco
#
# Or any server that holds <info hash>/<station>/<path> (dev builds too):
# SRC_MIRROR_URL=https://radio.example.org
